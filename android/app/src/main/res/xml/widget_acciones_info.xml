<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis: cada 30 min Android vuelve a pintar el widget; así, al
     cambiar el día, deja de decir «hoy» con los datos de ayer. Los datos los
     pone la app; el widget nunca consulta nada. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_acciones_desc"
    android:initialLayout="@layout/widget_acciones"
    android:minHeight="70dp"
    android:minResizeHeight="70dp"
    android:minResizeWidth="180dp"
    android:minWidth="250dp"
    android:previewLayout="@layout/widget_acciones"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
