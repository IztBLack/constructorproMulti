# Copia este archivo a `.env.local` y rellena los valores.
# `.env.local` está en .gitignore: nunca lo subas.

# ── Supabase (obligatorias) ─────────────────────────────────────────────────
# Las dos son públicas por diseño: la protección real es la RLS de Postgres.
# La `service_role` NO va aquí ni en ningún otro archivo del repo.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Sentry (opcional) ───────────────────────────────────────────────────────
# Sin esta variable el reporte de errores queda APAGADO y la app funciona igual;
# no hace falta cuenta de Sentry para clonar, correr ni desplegar el proyecto.
# El DSN es público (solo permite escribir eventos). Ver
# `src/lib/observabilidad/sentry.ts`.
#
# En el móvil la equivalente se pasa al compilar:
#   $env:SENTRY_DSN = "..."   antes de correr build_release.ps1
NEXT_PUBLIC_SENTRY_DSN=
